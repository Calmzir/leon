# Build output and release staging.
/target
/dist
/work

# graft's local graph cache: regenerable, not committed (run `graft build`).
/graft/

# Local tools and state.
.codegraph/
.claude/
.engram/
.env
.env.*
*.p12
*.pfx
*.pem
*.key
*.keychain-db

# Mobile (mobile/): dependencies and everything a native build produces. The
# TypeScript and C++ that uniffi-bindgen-react-native generates are committed;
# the Rust libraries it builds for each phone architecture are not.
node_modules/
*.tsbuildinfo
.expo/
/mobile/**/dist/
/mobile/**/android/build/
/mobile/**/android/.gradle/
/mobile/**/android/.cxx/
/mobile/**/android/local.properties
/mobile/**/android/generated/
/mobile/**/ios/Pods/
/mobile/**/ios/build/
/mobile/**/ios/generated/
/mobile/**/ios/DerivedData/
xcuserdata/
*.xcuserstate
/mobile/modules/*/android/src/main/jniLibs/
/mobile/modules/*/*.xcframework/
/mobile/modules/*/build/

# Operating system and editors.
.DS_Store
Thumbs.db
.idea/
.vscode/
.zed/
*.swp
*~

# Brand: only the final marks and the token table are published. Rejected logo
# explorations, bulky renders (with third-party source photos) and the internal
# brand book stay on the owner's machine.
/brand/logo/round-*/
/brand/logo/direction-*/
/brand/logo/simple/
/brand/logo/png/
/brand/logo/sheet.*
/brand/brandbook.md
